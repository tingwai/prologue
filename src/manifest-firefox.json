{
  "manifest_version": 2,
  "name": "Prologue",
  "version": "1.0.0",
  "description": "AI-powered GitHub PR context and code explanations",
  "permissions": [
    "storage",
    "activeTab",
    "https://github.com/*",
    "https://api.github.com/*",
    "https://patch-diff.githubusercontent.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Prologue"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "prologue@tingwai.dev",
      "strict_min_version": "109.0"
    }
  }
}
