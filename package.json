{
  "name": "pr-context-assistant",
  "version": "1.0.0",
  "description": "AI-powered Chrome/Firefox extension for GitHub PR context and explanations",
  "scripts": {
    "build": "webpack --mode production --env target=chrome",
    "build:firefox": "webpack --mode production --env target=firefox",
    "dev": "webpack --mode development --watch --env target=chrome",
    "dev:firefox": "webpack --mode development --watch --env target=firefox",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/webextension-polyfill": "^0.10.7",
    "copy-webpack-plugin": "^12.0.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
